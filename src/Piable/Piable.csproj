<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Piable</RootNamespace>
    <AssemblyName>Piable</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 编译期绑定：绑定错误在构建时报错，而非运行期静默失败 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- AOT 友好：禁用 STJ 反射回退，所有序列化必须走 PiableJsonContext 源生成器 -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!-- 便于异常定位；与 AOT 兼容 -->
    <DebugType>embedded</DebugType>

    <!-- AOT 仅在显式开启时启用（发布阶段验证后再定） -->
    <PublishAot Condition="'$(AotEnabled)' == 'true'">true</PublishAot>
    <InvariantGlobalization Condition="'$(AotEnabled)' == 'true'">false</InvariantGlobalization>

    <!-- 不把第三方包附带的 .pdb / .xml 复制到发布目录。
         SkiaSharp 等的调试符号单个就有 80MB，对最终用户毫无用处。 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- 单文件发布：把原生库(Skia/HarfBuzz/SQLite/ANGLE)一并打包并压缩 -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    语言包以嵌入资源打包，而不是作为散落的文件随程序发布：
    单文件发布时不会有额外文件，也不依赖进程的工作目录。

    WithCulture="false" 不可省：文件名里的 zh-CN / en-US 会被 MSBuild 的
    AssignCulture 当成区域性后缀，把资源编进 zh-CN\Piable.resources.dll
    这样的卫星程序集里，主程序集反而读不到——界面上就是一片 Loc.xxx。
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Strings.zh-CN.json" LogicalName="Piable.Resources.Strings.zh-CN.json" WithCulture="false" />
    <EmbeddedResource Include="Resources\Strings.en-US.json" LogicalName="Piable.Resources.Strings.en-US.json" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.341" />
    <PackageReference Include="LiveMarkdown.Avalonia" Version="2.4.0" />
    <PackageReference Include="LiveMarkdown.Avalonia.Mermaid" Version="2.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Piable.Tests" />
  </ItemGroup>


  <!--
    剔除第三方原生库附带的调试符号。SkiaSharp / HarfBuzz 的 .pdb 合计上百 MB，
    它们由原生资源包直接提供，AllowedReferenceRelatedFileExtensions 覆盖不到，
    只能在发布文件列表计算完成后过滤。
    Release 下本程序自身的符号已通过 DebugType=embedded 内嵌进可执行文件，不受影响。
  -->
  <Target Name="ExcludeNativeSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
